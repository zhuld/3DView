{
  "name": "3dview",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "3D object viewer with head-motion parallax and pinch-gesture rotation",
  "license": "MIT",
  "scripts": {
    "predev": "node scripts/fetch-assets.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
